<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SentimentAnalysis.PopoutChartWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SentimentAnalysis.Controls"
    Title="Sentiment — Always On Top">

    <Grid Padding="12" RowSpacing="8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sentiment Over Time"
                   Style="{StaticResource BodyStrongTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" />
                <TextBlock Text="Positive" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Ellipse Width="8" Height="8" Fill="#6366F1" VerticalAlignment="Center" />
                <TextBlock Text="Neutral" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Ellipse Width="8" Height="8" Fill="#EF4444" VerticalAlignment="Center" />
                <TextBlock Text="Negative" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
            </StackPanel>
        </StackPanel>

        <controls:SentimentChart x:Name="Chart" Grid.Row="2" MinHeight="160" />
    </Grid>
</Window>
