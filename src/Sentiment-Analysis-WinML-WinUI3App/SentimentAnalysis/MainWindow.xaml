<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SentimentAnalysis.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SentimentAnalysis"
    xmlns:controls="using:SentimentAnalysis.Controls"
    xmlns:converters="using:SentimentAnalysis.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Contoso Customer Support — Sentiment Analysis">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <converters:SentimentToBrushConverter x:Key="SentimentToBrush" />
            <converters:SentimentToEmojiConverter x:Key="SentimentToEmoji" />
            <converters:SentimentToLabelConverter x:Key="SentimentToLabel" />
        </Grid.Resources>

        <Grid Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Contoso Support Dashboard"
                               Style="{StaticResource TitleTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Real-time customer sentiment analysis"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.6" />
                        <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                CornerRadius="4" Padding="8,2"
                                Visibility="{x:Bind ViewModel.ModelStatusVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.ModelStatus, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{x:Bind ViewModel.ToggleStreamCommand}"
                        Content="{x:Bind ViewModel.ToggleButtonText, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        MinWidth="120"
                        VerticalAlignment="Center" />
            </Grid>

            <!-- Stats Cards Row -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Total Messages -->
                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Total Messages" Opacity="0.6"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalMessages, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Border>

                <!-- Messages/sec -->
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Messages/sec" Opacity="0.6"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.MessagesPerSecond, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Border>

                <!-- Positive -->
                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="😊 Positive" Foreground="#10B981"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.PositiveCount, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" Foreground="#10B981" />
                    </StackPanel>
                </Border>

                <!-- Neutral -->
                <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="😐 Neutral" Foreground="#6366F1"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.NeutralCount, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" Foreground="#6366F1" />
                    </StackPanel>
                </Border>

                <!-- Negative -->
                <Border Grid.Column="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="😠 Negative" Foreground="#EF4444"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.NegativeCount, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" Foreground="#EF4444" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Main Content: Chart + Message Feed -->
            <Grid Grid.Row="2" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <!-- Sentiment Chart -->
                <Border Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Sentiment Over Time (3s intervals)"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="PopoutButton" Grid.Column="1"
                                    Click="OnPopoutClick"
                                    ToolTipService.ToolTip="Pop out chart"
                                    Padding="8,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                    <TextBlock Text="Popout Overlay" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Legend -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" />
                                <TextBlock Text="Positive" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="8" Height="8" Fill="#6366F1" VerticalAlignment="Center" />
                                <TextBlock Text="Neutral" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="8" Height="8" Fill="#EF4444" VerticalAlignment="Center" />
                                <TextBlock Text="Negative" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                            </StackPanel>
                        </StackPanel>

                        <controls:SentimentChart Grid.Row="2"
                            Snapshots="{x:Bind ViewModel.Snapshots, Mode=OneWay}"
                            MinHeight="200" />
                    </Grid>
                </Border>

                <!-- Message Feed -->
                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Live Message Feed"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:SupportMessageWrapper">
                                    <Grid Padding="4,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Sentiment Emoji -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind Emoji, Mode=OneWay}"
                                                   FontSize="20"
                                                   VerticalAlignment="Center" />

                                        <!-- Message Content -->
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind CustomerName}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Message}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Opacity="0.8" />
                                        </StackPanel>

                                        <!-- Sentiment Label + Score -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                    HorizontalAlignment="Right" Spacing="2">
                                            <Border Background="{x:Bind SentimentBrush, Mode=OneWay}"
                                                    CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{x:Bind SentimentLabel, Mode=OneWay}"
                                                           FontSize="11" Foreground="White"
                                                           HorizontalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{x:Bind TimeLabel}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Opacity="0.5" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
